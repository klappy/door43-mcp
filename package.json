{
  "name": "door43-mcp",
  "version": "0.7.0",
  "private": true,
  "description": "Cloudflare Worker MCP server fronting a DCS/Gitea host as the logged-in user. Three tools: `docs` (ladder + recipes), `execute` (GET/HEAD, envelope, fields, refresh-on-401), `telemetry` (SELECT-only, D1 exact channel).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs": "vite-node -c vitest.config.ts scripts/docs.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.7.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "^0.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.99.0"
  }
}
