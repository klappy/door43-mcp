{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "door43-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Custom domain: wrangler creates the DNS record on deploy (route bound to the host).
  "routes": [{ "pattern": "door43.klappy.dev", "custom_domain": true }],
  // Branch tasting: workers.dev route stays OFF; preview URLs ON (wrangler ≥4.44 otherwise resets them to match workers.dev on every upload).
  // Non-main builds run `versions upload --preview-alias <branch>` → https://<branch>-door43-mcp.klappy.workers.dev (observed 2026-09-03; CF "Worker Previews"/`wrangler preview` is gated on this account, error 10015).
  "workers_dev": false,
  "preview_urls": true,
  // Provider state: hashed OAuth grants + per-grant encrypted props (SPEC §Stack).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "a9311ccc415a417f894a0d666362977c" }],
  // Telemetry exact channel (ticket 2026-09-02-door43-mcp-gate2-3): the ONE D1 created by CoS 02:32Z. Bind, never create another.
  "d1_databases": [{ "binding": "TELEMETRY_DB", "database_name": "door43mcp_telemetry", "database_id": "52fa8ea4-7774-4135-b160-f17bb41ac660" }],
  // McpAgent is a Durable Object (agents package). One class, sqlite-backed.
  "durable_objects": { "bindings": [{ "name": "MCP_OBJECT", "class_name": "Door43MCP" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Door43MCP"] }],
  // Secrets (Worker secrets only, never here): D43_CLIENT_ID, D43_CLIENT_SECRET, COOKIE_ENCRYPTION_KEY.
  "vars": { "D43_HOST": "git.door43.org" },
  // docs/SURFACE.md is imported as text by src/surface.ts (the homepage copy). vitest does the same via its plugin.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }]
}
